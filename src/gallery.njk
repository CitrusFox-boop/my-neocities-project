---
layout: base.njk
title: The Vault
---

<div class="container">
    <div class="marquee-container" style="margin-bottom: 20px;">
        <div class="bulbs"></div>
        <h1>THE VAULT</h1>
        <div class="subtitle">ARTIFACTS & CREATIONS</div>
    </div>

    <div style="text-align: center; margin-bottom: 30px; margin-top: 10px;">
        <a href="https://citrusfoxafterdark.neocities.org/" target="_blank" 
           style="color: #ff0000; font-weight: bold; font-size: 1.4em; text-decoration: none; border-bottom: 2px solid #ff0000; font-family: sans-serif; letter-spacing: 1px;">
           >> TO THE RED TENT (18+) <<
        </a>
    </div>

    <nav>
        <a href="/" class="ticket">&lt;&lt; BACK TO LOBBY</a>
    </nav>

    <div class="gallery-grid" id="gallery-container">
        {% for art in collections.gallery | reverse %}
        <div class="art-frame" onclick="openLightbox({{ loop.index0 }})">
            <div class="art-image">
                <img src="{{ art.data.image }}" alt="Gallery Image" loading="lazy">
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<div id="lightbox-overlay" class="lightbox">
    <span class="close-btn" onclick="closeLightbox()">&times;</span>
    
    <a class="prev" onclick="changeSlide(-1)">&#10094;</a>
    <a class="next" onclick="changeSlide(1)">&#10095;</a>

    <div class="lightbox-wrapper">
        <img class="lightbox-content" id="lightbox-img" onclick="toggleZoom()">
    </div>
</div>

<style>
    /* --- GRID LAYOUT --- */
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        width: 100%;
        padding: 20px 0;
    }
    
    .art-frame {
        background: #000;
        border: 2px solid var(--digi-blue);
        box-shadow: 6px 6px 0 var(--digi-purple);
        transition: 0.2s;
        cursor: pointer;
        position: relative;
        height: 200px; /* Fixed height for uniformity */
    }

    .art-frame:hover {
        transform: translateY(-5px);
        border-color: var(--digi-yellow);
        box-shadow: 8px 8px 0 var(--digi-red);
        z-index: 10;
    }

    .art-image {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .art-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.3s;
    }
    
    .art-frame:hover img {
        transform: scale(1.1);
    }

    /* --- LIGHTBOX & ZOOM STYLES --- */
    .lightbox {
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
        backdrop-filter: blur(5px);
        overflow: hidden;
    }

    .lightbox-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: auto; /* Allow scrolling when zoomed */
    }

    .lightbox-content {
        max-width: 90%;
        max-height: 85vh;
        border: 2px solid var(--digi-yellow);
        box-shadow: 0 0 50px var(--digi-blue);
        cursor: zoom-in; /* Show magnifying glass */
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    /* THE ZOOM EFFECT */
    .lightbox-content.zoomed {
        transform: scale(2); /* 2x Magnification */
        cursor: zoom-out;
        z-index: 1002;
    }

    .close-btn {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #f1f1f1;
        font-size: 60px;
        font-weight: bold;
        transition: 0.3s;
        cursor: pointer;
        z-index: 2000;
    }

    .close-btn:hover { color: var(--digi-red); }

    .prev, .next {
        cursor: pointer;
        position: absolute;
        top: 50%;
        width: auto;
        padding: 16px;
        margin-top: -50px;
        color: white;
        font-weight: bold;
        font-size: 40px;
        transition: 0.6s ease;
        border-radius: 0 3px 3px 0;
        user-select: none;
        z-index: 2000;
        background-color: rgba(0,0,0,0.5);
    }

    .next { right: 0; border-radius: 3px 0 0 3px; }
    .prev:hover, .next:hover { background-color: var(--digi-blue); color: #000; }
</style>

<script>
    // --- VARIABLES ---
    let currentIndex = 0;
    let galleryItems = [];

    // --- LOAD IMAGES ---
    document.addEventListener("DOMContentLoaded", function() {
        // We select the images directly since we removed the hidden text captions
        const frames = document.querySelectorAll('.art-frame');
        frames.forEach((frame) => {
            const img = frame.querySelector('img');
            galleryItems.push(img.src);
        });
    });

    // --- OPEN LIGHTBOX ---
    function openLightbox(index) {
        currentIndex = index;
        updateLightboxContent();
        document.getElementById("lightbox-overlay").style.display = "block";
    }

    // --- CLOSE LIGHTBOX ---
    function closeLightbox() {
        document.getElementById("lightbox-overlay").style.display = "none";
        resetZoom(); // Always reset zoom when closing
    }

    // --- CHANGE SLIDE ---
    function changeSlide(n) {
        currentIndex += n;
        
        // Loop logic
        if (currentIndex >= galleryItems.length) {
            currentIndex = 0;
        } else if (currentIndex < 0) {
            currentIndex = galleryItems.length - 1;
        }
        
        updateLightboxContent();
        resetZoom(); // Reset zoom when changing image
    }

    // --- UPDATE CONTENT ---
    function updateLightboxContent() {
        document.getElementById("lightbox-img").src = galleryItems[currentIndex];
    }

    // --- ZOOM FUNCTIONS ---
    function toggleZoom() {
        const img = document.getElementById("lightbox-img");
        img.classList.toggle("zoomed");
    }

    function resetZoom() {
        const img = document.getElementById("lightbox-img");
        img.classList.remove("zoomed");
    }

    // --- KEYBOARD CONTROLS ---
    document.addEventListener('keydown', function(event) {
        if (document.getElementById("lightbox-overlay").style.display === "block") {
            if (event.key === "ArrowLeft") {
                changeSlide(-1);
            } else if (event.key === "ArrowRight") {
                changeSlide(1);
            } else if (event.key === "Escape") {
                closeLightbox();
            }
        }
    });
</script>